rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /* All nested data for this user (flashcard decks, quiz progress, etc.). */
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /usernames/{key} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(key));
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    function inviteDoc(teamId, toUid) {
      return get(/databases/$(database)/documents/teamInvites/$(teamId + '__invite__' + toUid));
    }

    function inviteExists(teamId, toUid) {
      return exists(/databases/$(database)/documents/teamInvites/$(teamId + '__invite__' + toUid));
    }

    function inviteIsPending(teamId, toUid) {
      return inviteExists(teamId, toUid)
        && inviteDoc(teamId, toUid).data.status == 'pending'
        && inviteDoc(teamId, toUid).data.toUid == toUid
        && inviteDoc(teamId, toUid).data.teamId == teamId;
    }

    function teamGet(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId));
    }

    function isTeamMember(teamId, uid) {
      return exists(/databases/$(database)/documents/teams/$(teamId))
        && teamGet(teamId).data.memberUids is list
        && uid in teamGet(teamId).data.memberUids;
    }

    match /teams/{teamId} {
      /*
       * list = collection queries only. Must NOT call get()/exists() on other collections.
       * Two allow list lines are OR'd — each maps to one client query shape (Firebase rules-query).
       */
      allow list: if request.auth != null
        && resource.data.memberUids is list
        && request.auth.uid in resource.data.memberUids;

      allow list: if request.auth != null
        && resource.data.createdByUid == request.auth.uid;

      allow get: if request.auth != null && (
        !exists(/databases/$(database)/documents/teams/$(teamId))
        || (resource.data.createdByUid == request.auth.uid)
        || (resource.data.memberUids is list && request.auth.uid in resource.data.memberUids)
        || inviteIsPending(teamId, request.auth.uid)
      );

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'createdByUid', 'memberUids', 'createdAt'])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 1
        && request.auth.uid in request.resource.data.memberUids;

      allow update: if request.auth != null && (
        inviteIsPending(teamId, request.auth.uid)
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.memberUids is list
        && resource.data.memberUids is list
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.auth.uid in request.resource.data.memberUids
        && !(request.auth.uid in resource.data.memberUids)
      )
      || (request.auth != null && request.auth.uid == resource.data.createdByUid);

      allow delete: if request.auth != null
        && resource.data.createdByUid == request.auth.uid;
    }

    match /teams/{teamId}/messages/{msgId} {
      allow read: if request.auth != null && isTeamMember(teamId, request.auth.uid);
      allow create: if request.auth != null
        && isTeamMember(teamId, request.auth.uid)
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.keys().hasAll(['fromUid', 'createdAt', 'text'])
        && (
          request.resource.data.keys().hasOnly(['fromUid', 'createdAt', 'text'])
          || request.resource.data.keys().hasOnly(['fromUid', 'createdAt', 'text', 'fileLabel'])
        );
    }

    match /teams/{teamId}/roster/{uid} {
      allow read: if request.auth != null && isTeamMember(teamId, request.auth.uid);
      allow create, update: if request.auth != null
        && isTeamMember(teamId, request.auth.uid)
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['label', 'updatedAt']);
    }

    match /teams/{teamId}/presence/{uid} {
      allow read: if request.auth != null && isTeamMember(teamId, request.auth.uid);
      allow create, update: if request.auth != null
        && isTeamMember(teamId, request.auth.uid)
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastSeen']);
    }

    match /teams/{teamId}/presentations/{presId} {
      allow read: if request.auth != null && isTeamMember(teamId, request.auth.uid);
      allow create: if request.auth != null
        && isTeamMember(teamId, request.auth.uid)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['url', 'authorUid', 'authorLabel', 'createdAt']);
      allow delete: if request.auth != null
        && isTeamMember(teamId, request.auth.uid)
        && resource.data.authorUid == request.auth.uid;
    }

    match /teams/{teamId}/activity/{activityId} {
      allow read: if request.auth != null && isTeamMember(teamId, request.auth.uid);
      allow create: if request.auth != null
        && isTeamMember(teamId, request.auth.uid)
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.type in ['post', 'presentation', 'project', 'invite_sent', 'member_joined', 'member_kicked']
        && request.resource.data.actorLabel is string
        && request.resource.data.actorLabel.size() <= 160
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 500
        && request.resource.data.keys().hasOnly(['type', 'actorUid', 'actorLabel', 'summary', 'createdAt']);
    }

    /* Attachments: embedded dataUrl and/or external storageUrl (share links, Firebase download URLs). */
    function attachmentOk(m) {
      return m is map
        && m.name is string && m.name.size() <= 240
        && m.mimeType is string && m.mimeType.size() <= 120
        && m.size is int && m.size >= 0 && m.size < 6000000
        && m.dataUrl is string && m.dataUrl.size() <= 750000
        && (
          m.keys().hasOnly(['name', 'mimeType', 'size', 'dataUrl'])
          || (
            m.keys().hasOnly(['name', 'mimeType', 'size', 'dataUrl', 'storageUrl'])
            && m.storageUrl is string
            && m.storageUrl.size() >= 8
            && m.storageUrl.size() <= 2048
          )
        );
    }

    function attachmentsOk(a) {
      return a is list && a.size() <= 3 && (
        a.size() == 0 ||
        (a.size() == 1 && attachmentOk(a[0])) ||
        (a.size() == 2 && attachmentOk(a[0]) && attachmentOk(a[1])) ||
        (a.size() == 3 && attachmentOk(a[0]) && attachmentOk(a[1]) && attachmentOk(a[2]))
      );
    }

    match /teams/{teamId}/posts/{postId} {
      allow read: if request.auth != null && isTeamMember(teamId, request.auth.uid);
      allow create: if request.auth != null
        && isTeamMember(teamId, request.auth.uid)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 12000
        && request.resource.data.component is string
        && request.resource.data.component.size() <= 80
        && request.resource.data.authorLabel is string
        && request.resource.data.authorLabel.size() <= 160
        && attachmentsOk(request.resource.data.attachments)
        && request.resource.data.keys().hasOnly([
          'title',
          'description',
          'component',
          'authorUid',
          'authorLabel',
          'attachments',
          'createdAt',
        ]);
      allow delete: if request.auth != null
        && isTeamMember(teamId, request.auth.uid)
        && resource.data.authorUid == request.auth.uid;
    }

    match /teams/{teamId}/projects/{projectId} {
      allow read: if request.auth != null && isTeamMember(teamId, request.auth.uid);
      allow create: if request.auth != null
        && isTeamMember(teamId, request.auth.uid)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.objectives is list
        && request.resource.data.keys().hasOnly([
          'title',
          'objectives',
          'createdByUid',
          'createdAt',
          'updatedAt',
        ]);
      allow update: if request.auth != null
        && isTeamMember(teamId, request.auth.uid)
        && resource.data.createdByUid == request.resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly([
          'title',
          'objectives',
          'createdByUid',
          'createdAt',
          'updatedAt',
        ]);
      allow delete: if request.auth != null
        && isTeamMember(teamId, request.auth.uid)
        && resource.data.createdByUid == request.auth.uid;
    }

    match /teamInvites/{inviteId} {
      /* Missing docs: allow getDoc() before create (sender checks existing invite). No data leaked. */
      allow read: if request.auth != null && (
        !exists(/databases/$(database)/documents/teamInvites/$(inviteId))
        || resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid
      );

      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.teamId is string
        && request.resource.data.teamName is string
        && request.resource.data.toUid is string
        && request.resource.data.fromUid != request.resource.data.toUid
        && isTeamMember(request.resource.data.teamId, request.auth.uid)
        && inviteId == request.resource.data.teamId + '__invite__' + request.resource.data.toUid
        && request.resource.data.keys().hasOnly([
          'teamId',
          'teamName',
          'fromUid',
          'fromUsername',
          'toUid',
          'status',
          'createdAt'
        ]);

      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status is string
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid;

      allow delete: if request.auth != null && (
        resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
      );
    }
  }
}
