# Copy this file to ".env" in the same folder as server.cjs and paste your key.
# The real ".env" file is gitignored — never commit it.
#
# Firebase Admin (server-side Firestore / profile sync): the server expects the FULL
# service account JSON file, not separate email/key variables.
# Save the downloaded *-firebase-adminsdk-*.json as serviceAccountKey.json next to server.cjs (gitignored),
# or set GOOGLE_APPLICATION_CREDENTIALS to that file’s path, or FIREBASE_SERVICE_ACCOUNT_JSON (entire JSON on one line).

ANTHROPIC_API_KEY=

# Optional (defaults to claude-sonnet-4-6 if unset):
# ANTHROPIC_MODEL=claude-sonnet-4-6
